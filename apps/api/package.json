{
  "name": "@plataforma/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "node scripts/migrate.mjs",
    "test:rls": "vitest run --config vitest.rls.config.mts",
    "test:resiliencia": "vitest run --config vitest.resiliencia.config.mts",
    "test:backup-restore": "node test/resiliencia/backup-restore.mjs",
    "test:security": "vitest run --config vitest.security.config.mts",
    "serve:dast": "vitest run --config vitest.dast.config.mts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@plataforma/shared": "workspace:*",
    "drizzle-orm": "^0.45.0",
    "helmet": "8.1.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@nestjs/testing": "^11.1.0",
    "@types/node": "^22.20.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "supertest": "^7.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.11"
  }
}
