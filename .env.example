# =============================================================================
# Variáveis de ambiente — SOMENTE PLACEHOLDERS.
# Copie para .env (ignorado pelo git) e preencha com valores LOCAIS/DE TESTE.
# Em staging/prod os valores vêm do AWS Secrets Manager, nunca de arquivo.
# Nunca coloque aqui segredo real, certificado ou dado de paciente.
# =============================================================================

NODE_ENV=development

# --- API ---
API_PORT=3333
API_PUBLIC_URL=http://localhost:3333
WEB_PUBLIC_URL=http://localhost:3000
# Garantia de Saída (G4): dias de leitura/exportação após cancelamento. Padrão e piso: 90.
EXIT_WINDOW_DAYS=90

# --- PostgreSQL (docker compose local) ---
# Papel de runtime (sem BYPASSRLS) e papel de migrations separados
DATABASE_URL=postgresql://app_user:CHANGE_ME@localhost:5432/plataforma_saude
DATABASE_MIGRATOR_URL=postgresql://app_migrator:CHANGE_ME@localhost:5432/plataforma_saude
POSTGRES_PASSWORD=CHANGE_ME

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379
# Segredo do HMAC que deriva a chave do rate limit a partir do IP (≥ 32 bytes). Obrigatório em
# produção, igual em todas as instâncias, vindo do Secrets Manager. Vazio fora de produção = segredo
# aleatório por processo. Produção sem Redis exige RATE_LIMIT_ALLOW_SINGLE_INSTANCE=1 (fica no /health/ready).
RATE_LIMIT_HASH_KEY=
# Agendador de jobs (api-dominio §14): com REDIS_URL fora de teste, BullMQ. Produção sem Redis sobe SEM
# os jobs, com log JOBS_DESLIGADOS e jobs: "desligado" no /health/ready. false = desliga de propósito
# (instância só de HTTP), também logado. Vazio = true.
JOBS_HABILITADOS=

# --- Sessão / Auth ---
SESSION_SECRET=CHANGE_ME_LOCAL_ONLY

# --- Criptografia de campo ---
# Local: chave de desenvolvimento gerada por você. Staging/prod: AWS KMS.
KMS_PROVIDER=local
KMS_KEY_ID=CHANGE_ME
FIELD_ENCRYPTION_LOCAL_KEY=CHANGE_ME_BASE64_32_BYTES
BLIND_INDEX_KEY=CHANGE_ME_BASE64_32_BYTES
# Pseudônimo do atendente do suporte na trilha de auditoria (migração 0008; N1 do #57).
# Staging/prod: chave HMAC_256 no KMS (só kms:GenerateMac para o papel da API); o segredo nunca entra
# no processo. Sem ela fora de development/test, a API não sobe.
SUPPORT_PSEUDONYM_KMS_KEY_ID=
# Só development/test: segredo local, base64 ≥ 32 bytes (vazio = aleatório por processo).
# Recusado em qualquer outro NODE_ENV.
SUPPORT_PSEUDONYM_KEY=
# --- Limite por usuário e alerta de anomalia na leitura de pacientes (R5 do #57; vazios = padrão) ---
PATIENT_LIST_USER_MAX=
PATIENT_LIST_USER_WINDOW_MS=
PATIENT_ANOMALY_WINDOW_MS=
PATIENT_ANOMALY_LIST_PAGES=
PATIENT_ANOMALY_DISTINCT_RECORDS=
# --- Janela de "em atendimento" e alerta de autoagendamento (V1 do #61; vazios = padrão) ---
# Minutos antes do início (padrão 30, teto 120) e depois do fim (padrão 60, teto 1440).
ATTENDANCE_WINDOW_BEFORE_MIN=
ATTENDANCE_WINDOW_AFTER_MIN=
# Pacientes distintos/24 h por autoagendamento atendido acima dos quais grava anomaly_alert (padrão 0).
SELF_SCHEDULED_ALERT_PER_DAY=

# --- Object storage (S3 compatível) ---
S3_REGION=sa-east-1
S3_BUCKET=CHANGE_ME
S3_ENDPOINT=

# --- Integrações (usar sempre credenciais de sandbox em dev) ---
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
WHATSAPP_ACCESS_TOKEN=CHANGE_ME
WHATSAPP_WEBHOOK_VERIFY_TOKEN=CHANGE_ME
PAYMENT_PROVIDER=asaas
PAYMENT_API_KEY=CHANGE_ME
PAYMENT_WEBHOOK_SECRET=CHANGE_ME
NFSE_PROVIDER=focusnfe
NFSE_API_TOKEN=CHANGE_ME
SIGNATURE_PROVIDER=birdid
SIGNATURE_CLIENT_ID=CHANGE_ME
SIGNATURE_CLIENT_SECRET=CHANGE_ME
MEMED_API_KEY=CHANGE_ME
MEMED_SECRET_KEY=CHANGE_ME
VIDEO_PROVIDER=livekit
VIDEO_API_KEY=CHANGE_ME
VIDEO_API_SECRET=CHANGE_ME

# --- Observabilidade ---
SENTRY_DSN=
LOG_LEVEL=info
