{
  "name": "plataforma-saude",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "patchedDependencies": {
      "postgres@3.4.9": "patches/postgres@3.4.9.patch"
    },
    "overrides": {
      "body-parser@>=2.0.0 <2.4.0": "^2.4.0",
      "multer@>=2.0.0 <2.5.0": "^2.5.0",
      "qs@>=6.7.0 <6.16.1": "^6.16.1"
    }
  }
}
